<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MercedesEISTool.GUI.ViewModels"
        x:Class="MercedesEISTool.GUI.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="Sign in"
        Width="420"
        Height="260"
        CanResize="False">
  <Design.DataContext>
    <vm:LoginViewModel />
  </Design.DataContext>

  <StackPanel Margin="24" Spacing="12">
    <TextBlock Text="Mercedes EIS Tool"
               FontSize="20"
               FontWeight="Bold" />

    <TextBlock Text="Sign in to continue" />

    <TextBox PlaceholderText="Email"
             Text="{Binding Email, Mode=TwoWay}" />

    <TextBox PlaceholderText="Password"
             Text="{Binding Password, Mode=TwoWay}"
             PasswordChar="*" />

    <Button Content="Sign in"
            Command="{Binding LoginCommand}"
            HorizontalAlignment="Right" />

    <TextBlock Text="{Binding Status}"
               TextWrapping="Wrap" />
  </StackPanel>
</Window>

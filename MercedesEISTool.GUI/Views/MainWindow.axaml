<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MercedesEISTool.GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="MercedesEISTool.GUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Mercedes EIS Toolkit">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <Border Grid.Row="0" Padding="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Open BIN" Command="{Binding OpenDumpCommand}" />
                    <Button Content="Analyze" Command="{Binding AnalyzeDumpCommand}" />
                    <Button Content="Upload" Command="{Binding UploadDumpCommand}" IsEnabled="{Binding CanUpload}" />
                    <Button Content="Refresh Files" Command="{Binding RefreshUploadedFilesCommand}" />
                    <Button Content="Convert" Command="{Binding ConvertDumpCommand}" IsEnabled="{Binding CanConvert}" />
                    <Button Content="Save" Command="{Binding SaveDumpCommand}" IsEnabled="{Binding CanSave}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Padding="6,2" CornerRadius="8" Background="#2f5f2f">
                        <TextBlock Text="{Binding ServerStatus}" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="{Binding ConnectionUrl}" Width="220" TextWrapping="Wrap" />
                    <TextBlock Text="Korpidiagnostics" Opacity="0.55" FontSize="16" FontWeight="SemiBold" IsHitTestVisible="False" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="0,12,0,0">
            <TabItem Header="Details">
                <Border Padding="12" CornerRadius="6" Background="#202020">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Detected dump information" FontSize="18" FontWeight="SemiBold" />
                        <Border Padding="8" CornerRadius="4" Background="#303030">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Workflow" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedFileName}" />
                                <TextBlock Text="{Binding AnalysisSummary}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding UploadSummary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="VIN" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Vin}" IsReadOnly="True" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="EIS type" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EisType}" IsReadOnly="True" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Source format" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DetectedFormat}" IsReadOnly="True" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Target format" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding SupportedFormats}" SelectedItem="{Binding SelectedTargetFormat}" Width="180" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Vehicle information" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Grid.Row="4" Grid.Column="1" Padding="8" CornerRadius="4" Background="#303030">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="VIN" />
                                    <TextBox Text="{Binding VehicleIdentifier}" />
                                    <TextBlock Text="Detected status" />
                                    <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
                                    <TextBlock Text="Registration number" />
                                    <TextBox Text="{Binding RegistrationNumber}" />
                                    <CheckBox Content="I confirm that the vehicle identifier is correct" IsChecked="{Binding VinConfirmedByUser}" />
                                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="MCU type" VerticalAlignment="Center" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Mcu}" IsReadOnly="True" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Key count" VerticalAlignment="Center" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding KeyCount}" IsReadOnly="True" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="EIS password" VerticalAlignment="Center" />
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding EisPassword}" IsReadOnly="True" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="SSID" VerticalAlignment="Center" />
                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Ssid}" IsReadOnly="True" />

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Server" VerticalAlignment="Center" />
                            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding ServerStatus}" IsReadOnly="True" />

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Reason" VerticalAlignment="Center" />
                            <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding ConnectionReason}" IsReadOnly="True" />

                            <TextBlock Grid.Row="11" Grid.Column="0" Text="URL" VerticalAlignment="Center" />
                            <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding ConnectionUrl}" IsReadOnly="True" />

                            <TextBlock Grid.Row="12" Grid.Column="0" Text="Last checked" VerticalAlignment="Center" />
                            <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding LastChecked}" IsReadOnly="True" />

                            <Border Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2" Padding="0,8,0,0">
                                <Border Padding="8" CornerRadius="4" Background="#303030">
                                    <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="EIS State" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Initialized" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InitializedDisplay}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Personalized" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PersonalizedDisplay}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="TP cleared" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TpClearedDisplay}" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Activated" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ActivatedDisplay}" />
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Dealer EIS" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DealerEisDisplay}" />
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="FBS4" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Fbs4Display}" />
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="Raw Hex">
                <Border Padding="12" CornerRadius="6" Background="#202020">
                    <TextBox Text="{Binding RawHexText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="300" />
                </Border>
            </TabItem>
            <TabItem Header="My Files">
                <Border Padding="12" CornerRadius="6" Background="#202020">
                    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Persisted uploads" FontSize="18" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" RowDefinitions="Auto">
                                <TextBox Grid.Column="0" PlaceholderText="Search by file name or identifier" Text="{Binding MyFilesSearchText}" />
                                <Button Grid.Column="1" Content="Search" Command="{Binding SearchMyFilesCommand}" />
                                <Button Grid.Column="2" Content="Details" Command="{Binding OpenDetailsCommand}" />
                                <Button Grid.Column="3" Content="Load" Command="{Binding LoadIntoWorkspaceCommand}" />
                                <Button Grid.Column="4" Content="Reanalyze" Command="{Binding ReanalyzeStoredFileCommand}" />
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,8,0,0" ColumnDefinitions="2*,1*" ColumnSpacing="12">
                            <Border Padding="8" CornerRadius="4" Background="#303030">
                                <ListBox ItemsSource="{Binding StoredFiles}" SelectedItem="{Binding SelectedStoredFile}" SelectionMode="Single" MinHeight="240">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="6" CornerRadius="4" Background="#383838">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding OriginalFileName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding AnalysisStatus}" Opacity="0.8" />
                                                    <TextBlock Text="{Binding UploadedAtUtc, StringFormat='Uploaded {0:yyyy-MM-dd HH:mm}'}" Opacity="0.7" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="8">
                                <Border Padding="8" CornerRadius="4" Background="#303030">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Selection" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedStoredFileDisplay}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedStoredFile.OriginalFileName}" Opacity="0.8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="8" CornerRadius="4" Background="#303030">
                                    <StackPanel Spacing="6">
                                        <Button Content="Download original" Command="{Binding DownloadOriginalCommand}" />
                                        <Button Content="Set compare A" Command="{Binding SetCompareACommand}" />
                                        <Button Content="Set compare B" Command="{Binding SetCompareBCommand}" />
                                        <Button Content="Copy VIN" Command="{Binding CopyVinCommand}" />
                                        <Button Content="Copy registration" Command="{Binding CopyRegistrationCommand}" />
                                        <Button Content="Copy EIS password" Command="{Binding CopyEisPasswordCommand}" />
                                        <Button Content="Copy SSID" Command="{Binding CopySsidCommand}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8" CornerRadius="4" Background="#303030">
                            <TextBox Text="{Binding MyFilesDetails}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="Compare">
                <Border Padding="12" CornerRadius="6" Background="#202020">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Open file A" Command="{Binding OpenFileACommand}" />
                            <Button Content="Open file B" Command="{Binding OpenFileBCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding CompareSummary}" />
                        <TextBlock Text="{Binding CompareOffsets}" />
                        <TextBox Text="{Binding CompareText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="240" />
                        <Border Padding="8" CornerRadius="4" Background="#303030">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Byte sequence research" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="180,150,120,*" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Start offset (A)" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SequenceStartOffset}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Length" />
                                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SequenceLength}" />
                                    <Button Grid.Row="1" Grid.Column="1" Content="Search" Command="{Binding SearchSequenceCommand}" />
                                </Grid>
                                <TextBox Text="{Binding SequenceResults}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="120" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="Research">
                <Border Padding="12" CornerRadius="6" Background="#202020">
                    <ScrollViewer>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Safe research workspace" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Load one EIS dump, one optional key file, and one optional comparison dump. No conversion or binary editing is performed." TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Load EIS dump" Command="{Binding LoadResearchDumpCommand}" />
                                <Button Content="Load key file" Command="{Binding LoadResearchKeyFileCommand}" />
                                <Button Content="Load compare dump" Command="{Binding LoadResearchCompareDumpCommand}" />
                                <Button Content="Analyze Folder" Command="{Binding AnalyzeResearchFolderCommand}" />
                            </StackPanel>

                            <TextBlock Text="Research inputs" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="EIS dump" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ResearchEisPath}" IsReadOnly="True" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Key file" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ResearchKeyPath}" IsReadOnly="True" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Compare dump" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ResearchComparePath}" IsReadOnly="True" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Folder" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ResearchFolderPath}" IsReadOnly="True" />
                            </Grid>

                            <Border Padding="8" CornerRadius="4" Background="#303030">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Sequence search" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="150,150,120,*" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Source file" />
                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ResearchSourceFiles}" SelectedItem="{Binding ResearchSelectedSourceFile}" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Start offset" />
                                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ResearchStartOffset}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Length" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ResearchLength}" />
                                        <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding ResearchSearchModes}" SelectedItem="{Binding ResearchSelectedMode}" />
                                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ResearchXorValue}" PlaceholderText="XOR" />
                                        <Button Grid.Row="2" Grid.Column="3" Content="Search" Command="{Binding ResearchSearchCommand}" />
                                    </Grid>
                                    <TextBox Text="{Binding ResearchSearchResults}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="140" />
                                </StackPanel>
                            </Border>

                            <Border Padding="8" CornerRadius="4" Background="#303030">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Annotations" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ResearchAnnotationName}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="File format" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ResearchAnnotationFileFormat}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Offset" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ResearchAnnotationOffset}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Length" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ResearchAnnotationLength}" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Byte order" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ResearchAnnotationByteOrder}" />
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Notes" />
                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ResearchAnnotationNotes}" />
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Confidence" />
                                        <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding ResearchConfidenceValues}" SelectedItem="{Binding ResearchSelectedConfidence}" />
                                    </Grid>
                                    <Button Content="Save annotation" Command="{Binding SaveResearchAnnotationCommand}" />
                                    <Button Content="Export report" Command="{Binding ExportResearchReportCommand}" />
                                    <TextBlock Text="Report path" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding ResearchReportPath}" IsReadOnly="True" />
                                    <TextBox Text="{Binding ResearchAnnotationsText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="140" />
                                </StackPanel>
                            </Border>

                            <Border Padding="8" CornerRadius="4" Background="#303030">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Folder analysis" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding ResearchFolderAnalysisText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="140" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="0,8,0,0" />

        <TextBlock Grid.RowSpan="3"
                   Text="Korpidiagnostics"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0.08"
                   FontSize="42"
                   FontWeight="Bold"
                   IsHitTestVisible="False" />
    </Grid>
</Window>

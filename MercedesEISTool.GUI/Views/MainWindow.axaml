<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MercedesEISTool.GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="MercedesEISTool.GUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Mercedes EIS Toolkit">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="Open BIN" Command="{Binding OpenDumpCommand}" />
            <ComboBox ItemsSource="{Binding SupportedFormats}" SelectedItem="{Binding SelectedTargetFormat}" Width="180" />
            <Button Content="Convert" Command="{Binding ConvertDumpCommand}" />
            <Button Content="Save" Command="{Binding SaveDumpCommand}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" CornerRadius="6" Background="#202020">
            <StackPanel Spacing="10">
                <TextBlock Text="Detected dump information" FontSize="18" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="VIN" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Vin}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="EIS type" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EisType}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Format" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Format}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="MCU type" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Mcu}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Key count" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding KeyCount}" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="0,8,0,0" />
    </Grid>
</Window>
